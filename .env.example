# Explicit logger host override; use a documentation-only address.
SOLIS_HOST=192.0.2.10
# Comma-separated fallback logger hosts; these examples are non-routable.
SOLIS_HOST_CANDIDATES=192.0.2.11,192.0.2.12
# Solarman logger serial number; replace this obviously fake value.
SOLIS_LOGGER_SERIAL=1234567890
# Solarman logger MAC without separators; replace this obviously fake value.
SOLIS_LOGGER_MAC=001122334455
# Standalone forecast latitude in decimal degrees; replace this example.
SITE_LATITUDE=00.0000
# Standalone forecast longitude in decimal degrees; replace this example.
SITE_LONGITUDE=00.0000
# Octopus API key for optional tariff data; replace this obvious placeholder.
OCTOPUS_API_KEY=replace-with-octopus-api-key
# Octopus account identifier for optional tariff data; replace this fake account.
OCTOPUS_ACCOUNT=A-XXXXXXXX
# Home Assistant base URL; this local hostname is the usual default.
HA_URL=http://homeassistant.local:8123
# Optional and discouraged: prefer the token in ~/.claude.json to storing it here.
HA_TOKEN=example_not_a_real_home_assistant_token
